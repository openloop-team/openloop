# OpenLoop live end-to-end test configuration
#
# Copy to `.env.e2e`. This file is gitignored and must never be loaded by an
# OpenLoop runtime container.

# The live Slack test posts the triggering mention as a human. The user token
# needs chat:write, and both that user and the bot must belong to the channel.
E2E_SLACK_USER_TOKEN=
E2E_SLACK_CHANNEL=
