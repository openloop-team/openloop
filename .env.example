# OpenLoop — Docker Compose interpolation
#
# Copy this file to `.env` before running Docker Compose:
#   cp .env.example .env
#
# Compose reads `.env` automatically while resolving `${...}` expressions.
# Keep application/provider secrets in `.env.runtime` and broker secrets in
# `.env.broker`; never copy either trust domain into this file.

# -----------------------------------------------------------------------------
# PostgreSQL bootstrap
# -----------------------------------------------------------------------------
# Compose derives the in-network DATABASE_URL for runtime and broker services
# from this single set of values.
POSTGRES_USER=openloop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openloop

# -----------------------------------------------------------------------------
# Deployment-wide settings
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# Shared external-broker protocol settings. Compose injects the same values into
# both sides of the runtime/broker boundary.
BROKER_IDENTITY_ISSUER=openloop-app
BROKER_IDENTITY_AUDIENCE=openloop-broker
BROKER_EXECUTION_LEASE_SECONDS=900
BROKER_GENERATION_DEADLINE_SECONDS=1800
BROKER_RECONCILE_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# External broker topology (required only with docker-compose.broker.yml)
# -----------------------------------------------------------------------------
# OPENLOOP_BROKER_ROOT must be an absolute path on the Docker daemon host.
#OPENLOOP_BROKER_ROOT=/var/lib/openloop/broker

# Changing either numeric identity requires `docker compose ... up --build` so
# the image passwd/group entries stay aligned with Compose and provisioning.
#OPENLOOP_BROKER_UID=10002
#OPENLOOP_DATA_GID=10777

# Required by the broker service for the host Docker socket (Linux example).
#DOCKER_GID=999
#DOCKER_SOCKET=/var/run/docker.sock
