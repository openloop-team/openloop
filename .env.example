# OpenLoop — Docker Compose interpolation
#
# Copy this file to `.env` before running Docker Compose:
#   cp .env.example .env
#
# Compose reads `.env` automatically while resolving `${...}` expressions.
# Doppler injects secrets into the Compose process; Compose exposes only the
# declared values to containers as `/run/secrets/*`. Never copy credentials
# into this file.
#
# A commented entry below shows the default Compose already applies; uncomment
# one only to override it.

# -----------------------------------------------------------------------------
# PostgreSQL bootstrap
# -----------------------------------------------------------------------------
# Compose derives the password-free in-network DATABASE_URL for runtime and
# broker services from these values. Doppler supplies POSTGRES_PASSWORD and
# Compose mounts it separately as `/run/secrets/postgres_password`.
#POSTGRES_USER=openloop
#POSTGRES_DB=openloop

# Required from the openloop-deploy Doppler project: POSTGRES_PASSWORD.

# -----------------------------------------------------------------------------
# Deployment-wide settings
# -----------------------------------------------------------------------------
# One OpenLoop artifact is shared by runtime, broker, and broker-init. Set this
# to an immutable registry digest in a release deployment.
#OPENLOOP_IMAGE=openloop:local

#LOG_LEVEL=info

# Shared external-broker protocol settings. Compose injects the same values into
# both sides of the runtime/broker boundary.
#BROKER_IDENTITY_ISSUER=openloop-app
#BROKER_IDENTITY_AUDIENCE=openloop-broker
#BROKER_EXECUTION_LEASE_SECONDS=900
#BROKER_GENERATION_DEADLINE_SECONDS=1800

# Broker-side only; the runtime never runs the reconcile loop.
#BROKER_RECONCILE_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# External broker topology (required only with docker-compose.broker.yml)
# -----------------------------------------------------------------------------
# OPENLOOP_BROKER_ROOT must be an absolute path on the Docker daemon host.
OPENLOOP_BROKER_ROOT=/var/lib/openloop/broker

# Changing either numeric identity requires `docker compose ... up --build` so
# the image passwd/group entries stay aligned with Compose and provisioning.
#OPENLOOP_BROKER_UID=10002
#OPENLOOP_DATA_GID=10777

# Optional upstream socket override for the root-only permission adapter.
# The adapter creates its forwarded UDS as root:OPENLOOP_DATA_GID mode 0660;
# the non-root broker must retain OPENLOOP_DATA_GID as a supplementary group.
#DOCKER_SOCKET=/var/run/docker.sock
