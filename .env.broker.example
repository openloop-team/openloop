# OpenLoop external broker — broker-process environment only
#
# Copy to .env.broker. This file is gitignored and is loaded only by the
# `broker` service in docker-compose.broker.yml.
# In production, broker secrets may instead be mounted at `/run/secrets` using
# lowercase Settings field names, such as `broker_capability_roots` and
# `broker_runtime_roots`. Mount only broker-owned files into the broker service.
#
# The two blocks below are filled differently: the roots are broker-owned bytes
# you generate here, the public maps are DERIVED from app-side secrets and must
# not be invented. Each block says which.
#
# TRUST PARTITION (load-bearing):
#   .env.broker:  capability/runtime roots + identity/receipt PUBLIC keys
#   .env.runtime: identity PRIVATE key + receipt roots + app/provider secrets
# Never copy broker-side roots into .env.runtime. Never copy app-side signing
# material into this file. Compose injects DATABASE_URL from the POSTGRES_*
# values in .env because Postgres is a shared dependency, not a signing domain.

# GENERATED HERE — broker-owned secrets with no app-side counterpart. Produce a
# fresh value per entry with `openssl rand -base64 32`. Independent base64
# 32-byte roots, encoded as JSON maps. Do not reuse bytes within or across
# either map or with any app-side root/key; startup rejects a reused root.
BROKER_CAPABILITY_ROOTS={"cap-key-v1":"REPLACE_WITH_BASE64_32_BYTE_ROOT"}
BROKER_RUNTIME_ROOTS={"runtime-key-v1":"REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_ROOT"}

# Which version each map signs with now. The commented values are the defaults
# already applied, so set one only when you rotate — add the new version to the
# map above, then point this at it. The value must be a key of its own map; a
# version that is absent from it is refused at startup.
#BROKER_CAPABILITY_CURRENT_VERSION=cap-key-v1
#BROKER_RUNTIME_CURRENT_VERSION=runtime-key-v1

# DERIVED, NOT CHOSEN — the public halves of app-side secrets in .env.runtime.
# Identity publics correspond to BROKER_IDENTITY_PRIVATE_KEY; receipt publics
# correspond to the domain/version-derived signing keys rooted at
# BROKER_RECEIPT_ROOTS. Invented values are accepted at startup (they are valid
# 32-byte Ed25519 keys) and then fail silently at verification time: a wrong
# identity public rejects every app RPC, a wrong receipt public fails every
# checkpoint receipt. Generate both lines, ready to paste, with:
#
#   uv run openloop broker keys
#
# Run it where .env.runtime is readable — it prints only public bytes. Re-run
# after rotating the identity seed or adding a receipt root version.
BROKER_IDENTITY_PUBLIC_KEYS={"identity-v1":"REPLACE_WITH_BASE64_ED25519_PUBLIC"}
BROKER_RECEIPT_PUBLIC_KEYS={"receipt-key-v1":"REPLACE_WITH_BASE64_ED25519_PUBLIC"}
