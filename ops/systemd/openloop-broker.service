[Unit]
Description=OpenLoop privileged broker container
Documentation=file:/opt/openloop/ops/systemd/README.md
Requires=docker.service openloop-broker-init.service
Wants=network-online.target
After=network-online.target docker.service openloop-broker-init.service
RequiresMountsFor=/opt/openloop
PartOf=openloop.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=DOPPLER_CONFIG_DIR=/var/lib/openloop/broker
WorkingDirectory=/opt/openloop
ExecStartPre=/usr/bin/test -x /usr/bin/doppler
ExecStartPre=/usr/bin/test -d /var/lib/openloop/broker
ExecStartPre=/usr/bin/test -r /opt/openloop/docker-compose.deploy.yml
ExecStartPre=/usr/bin/test -r /opt/openloop/docker-compose.broker.yml
ExecStartPre=/usr/bin/test -r /opt/openloop/.env
ExecStartPre=/usr/bin/test -r /opt/openloop/configs/prd/runtime.env
ExecStartPre=/usr/bin/test -r /opt/openloop/configs/prd/broker.env
ExecStartPre=/usr/bin/doppler run -- /usr/bin/docker compose --project-name openloop --file docker-compose.deploy.yml --file docker-compose.broker.yml config --quiet
ExecStart=/usr/bin/doppler run -- /usr/bin/docker compose --project-name openloop --file docker-compose.deploy.yml --file docker-compose.broker.yml up --detach --no-deps --no-build --pull never --wait --wait-timeout 120 broker
ExecStop=/usr/bin/docker compose --project-name openloop --file docker-compose.deploy.yml --file docker-compose.broker.yml stop --timeout 30 broker
TimeoutStartSec=180
TimeoutStopSec=60
