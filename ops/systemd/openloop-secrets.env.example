# OpenLoop systemd secret environment
#
# Install as /etc/openloop/openloop-secrets.env with root:root ownership and
# mode 0600. Fill every active assignment before starting openloop.target.
# This file is parsed by systemd EnvironmentFile=, not by a shell.

POSTGRES_PASSWORD=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

GITHUB_TOKEN=
# Single-quoted EnvironmentFile values may span lines. Replace this complete
# placeholder with the GitHub App PEM, preserving the opening and closing
# single quotes.
GITHUB_APP_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----
REPLACE_WITH_GITHUB_APP_PRIVATE_KEY
-----END PRIVATE KEY-----'

CLAUDE_CODE_OAUTH_TOKEN=
CODING_WORKER_OPENHANDS_STATE_MASTER_KEY=

BROKER_IDENTITY_PRIVATE_KEY=
BROKER_RECEIPT_ROOTS='{"receipt-key-v1":"REPLACE_WITH_BASE64_32_BYTE_ROOT"}'
BROKER_CAPABILITY_ROOTS='{"cap-key-v1":"REPLACE_WITH_BASE64_32_BYTE_ROOT"}'
BROKER_RUNTIME_ROOTS='{"runtime-key-v1":"REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_ROOT"}'
