[Unit]
Description=OpenLoop PostgreSQL container
Documentation=file:/opt/openloop/ops/systemd/README.md
Requires=docker.service
Wants=network-online.target
After=network-online.target docker.service
RequiresMountsFor=/opt/openloop
PartOf=openloop.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/root
Environment=DOPPLER_CONFIG_DIR=/var/lib/openloop/runtime
WorkingDirectory=/opt/openloop
ExecStartPre=/usr/bin/test -x /usr/bin/doppler
ExecStartPre=/usr/bin/test -d /var/lib/openloop/runtime
ExecStartPre=/usr/bin/test -r /opt/openloop/docker-compose.deploy.yml
ExecStartPre=/usr/bin/test -r /opt/openloop/docker-compose.broker.yml
ExecStartPre=/usr/bin/test -r /opt/openloop/.env
ExecStartPre=/usr/bin/test -r /opt/openloop/configs/prd/runtime.env
ExecStartPre=/usr/bin/test -r /opt/openloop/configs/prd/broker.env
ExecStartPre=/usr/bin/doppler run -- /usr/bin/docker compose --project-name openloop --file docker-compose.deploy.yml --file docker-compose.broker.yml config --quiet
ExecStart=/usr/bin/doppler run -- /usr/bin/docker compose --project-name openloop --file docker-compose.deploy.yml --file docker-compose.broker.yml up --detach --no-deps --no-build --pull never --wait --wait-timeout 120 postgres
ExecStop=/usr/bin/docker compose --project-name openloop --file docker-compose.deploy.yml --file docker-compose.broker.yml stop --timeout 30 postgres
TimeoutStartSec=180
TimeoutStopSec=60
